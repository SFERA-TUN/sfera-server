[Unit]
Description=SFERA self-hosted IPv4 VPN
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=sfera-selfhost
Group=sfera-selfhost
EnvironmentFile=/etc/sfera-selfhost/server.env
ExecStartPre=+/opt/sfera/bin/network --selfhost up /etc/sfera-selfhost/active/peers
ExecStart=/opt/sfera/bin/sfera-net server --public-ip ${SFERA_IP} --peer-credentials /etc/sfera-selfhost/active/peers
ExecStopPost=+/opt/sfera/bin/network --selfhost down
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
